# TEMPLATE ONLY — this file IS committed (see the `!.env.example` rule in
# .gitignore). Never put a real secret here. Copy it to `.env`, which is
# gitignored, and fill the values in there.

# --- Phase 3 (agent layer) -------------------------------------------------
# Anthropic API key for the orchestrating agent.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used for the tool-calling loop. Configurable per approved decision.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Phase 2 (data pipeline) -----------------------------------------------
# Optional. Socrata rate-limits anonymous requests by IP; a free app token
# raises the limit. The ETL works without it.
# Register at https://datahub.transportation.gov/profile/app_tokens
SOCRATA_APP_TOKEN=
